# Copy to .env.local. Without these, authentication fails closed and /demo works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://127.0.0.1:3000
# Enable only after configuring each provider in Supabase.
AUTH_GOOGLE_ENABLED=false
AUTH_LINKEDIN_ENABLED=false
# B1 controller attestation only; NOT provider credentials. Never prefix with NEXT_PUBLIC.
# Leave empty until separately provisioning a matching private database controller key.
ACADEMIC_EXECUTION_KEY_ID=
ACADEMIC_EXECUTION_HMAC_KEY_HEX=
