# Copy to .env.local. Without these, authentication fails closed and /demo works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://127.0.0.1:3000
# Enable only after configuring each provider in Supabase.
AUTH_GOOGLE_ENABLED=false
AUTH_LINKEDIN_ENABLED=false
# Controller attestation only; NOT provider credentials. Never prefix with
# NEXT_PUBLIC. Leave empty until separately provisioning a matching private
# database controller key (academic_execution_private.controller_keys). Used
# by both the historical B1 control-plane path (migration 022,
# PROFESSOR_EXECUTION_V1/CONTROL_PLANE_ONLY) and the live provider-backed V2
# path (migration 025, PROFESSOR_EXECUTION_V2/PROVIDER_BACKED_V1) — the trust
# root is this one key store, not a protocol-version-specific secret.
ACADEMIC_EXECUTION_KEY_ID=
ACADEMIC_EXECUTION_HMAC_KEY_HEX=
# B2 provider-neutral AI runtime (src/server/academic-runtime), now composed
# into the live PROFESSOR_EXECUTION_V2 execution path (migration 025; see
# docs/19-live-professor-execution.md). The code-owned model-profile registry
# ships empty (no provider choice has been made), so today ANY stored
# modelProfileRef already fails closed to ABSTAINED/UNKNOWN_MODEL_PROFILE
# before these variables are ever consulted; they matter only once a real
# profile is added to that registry, at which point leaving both empty fails
# a matching HTTP_JSON profile closed to ABSTAINED/NO_PROVIDER_CONFIGURED
# instead. No vendor SDK is installed; a real integration is a generic
# HTTP/JSON endpoint the operator has separately reviewed and provisioned.
# Never prefix with NEXT_PUBLIC; never send this key to browser code.
ACADEMIC_PROVIDER_BASE_URL=
ACADEMIC_PROVIDER_API_KEY=
