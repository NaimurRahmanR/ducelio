# Copy to .env.local. Without these, authentication fails closed and /demo works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://127.0.0.1:3000
# Enable only after configuring each provider in Supabase.
AUTH_GOOGLE_ENABLED=false
AUTH_LINKEDIN_ENABLED=false
# B1 controller attestation only; NOT provider credentials. Never prefix with NEXT_PUBLIC.
# Leave empty until separately provisioning a matching private database controller key.
ACADEMIC_EXECUTION_KEY_ID=
ACADEMIC_EXECUTION_HMAC_KEY_HEX=
# B2 provider-neutral AI runtime (src/server/academic-runtime). The code-owned
# model-profile registry ships empty (no provider choice has been made), so
# today ANY stored modelProfileRef already fails closed to ABSTAINED/
# UNKNOWN_MODEL_PROFILE before these variables are ever consulted; they matter
# only once a real profile is added to that registry, at which point leaving
# both empty fails a matching HTTP_JSON profile closed to ABSTAINED/
# NO_PROVIDER_CONFIGURED instead. No vendor SDK is installed; a real
# integration is a generic HTTP/JSON endpoint the operator has separately
# reviewed and provisioned. Never prefix with NEXT_PUBLIC; never send this key
# to browser code. Not yet composed into the live migration-022 execution RPC
# — see docs/implementation-progress.md.
ACADEMIC_PROVIDER_BASE_URL=
ACADEMIC_PROVIDER_API_KEY=
