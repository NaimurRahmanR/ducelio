# Copy to .env.local. Without these, authentication fails closed and /demo works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://127.0.0.1:3000
# Enable only after configuring each provider in Supabase.
AUTH_GOOGLE_ENABLED=false
AUTH_LINKEDIN_ENABLED=false
# Controller attestation only; NOT provider credentials. Never prefix with
# NEXT_PUBLIC. Leave empty until separately provisioning a matching private
# database controller key (academic_execution_private.controller_keys). Used
# by both the historical B1 control-plane path (migration 022,
# PROFESSOR_EXECUTION_V1/CONTROL_PLANE_ONLY) and the live provider-backed V2
# path (migration 025, PROFESSOR_EXECUTION_V2/PROVIDER_BACKED_V1) — the trust
# root is this one key store, not a protocol-version-specific secret.
ACADEMIC_EXECUTION_KEY_ID=
ACADEMIC_EXECUTION_HMAC_KEY_HEX=
# PR22 native academic AI providers. Current production profiles use fixed
# official HTTPS endpoints and server-owned model routing; only the secret
# keys are configurable. Never prefix these with NEXT_PUBLIC and never send
# them to browser code. Leaving a required key empty fails that role closed
# to NO_PROVIDER_CONFIGURED before a provider call.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Legacy generic HTTP/JSON gateway support. No current Commercial V1
# production profile routes through these variables after PR22. Retained only
# for an explicitly reviewed legacy/future HTTP_JSON profile.
ACADEMIC_PROVIDER_BASE_URL=
ACADEMIC_PROVIDER_API_KEY=
# PR13 Commercial V1 commerce/payment/entitlement onboarding (migration 034;
# see docs/28-commercial-v1-commerce-onboarding.md). Stripe supplies payment
# EVIDENCE only -- the database remains authoritative for identity,
# entitlement and enrolment. Leaving any of the four below empty fails
# checkout closed and truthfully (public course browsing still works; no
# payment is ever simulated as successful).
#
# Real Stripe API keys (server-only secret key + webhook signing secret from
# your Stripe Dashboard -> Developers -> API keys / Webhooks). Never prefix
# with NEXT_PUBLIC; never send to browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Controller attestation only; NOT a Stripe credential. A SEPARATE trust
# root from ACADEMIC_EXECUTION_* above -- this claim binds ORDER identity
# for a webhook/reconciliation caller that has no live learner session,
# never a live session's own identity, so it is deliberately not the same
# key. Provision a matching database controller key
# (commercial_v1_commerce_private.controller_keys) before use. Never prefix
# with NEXT_PUBLIC; never send to browser code.
COMMERCE_CONTROLLER_KEY_ID=
COMMERCE_CONTROLLER_HMAC_KEY_HEX=
