{
  "name": "ducelio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:db": "vitest run tests/database.test.ts tests/rls.test.ts",
    "test:http": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "acceptance:preflight": "node --env-file-if-exists=.env.local scripts/acceptance/preflight.mjs",
    "acceptance:hosted": "node --env-file-if-exists=.env.local scripts/acceptance/hosted.mjs",
    "acceptance:concurrency": "node --env-file-if-exists=.env.local scripts/acceptance/concurrency.mjs",
    "acceptance:examiner-app": "node --env-file-if-exists=.env.local scripts/acceptance/examiner-app.mjs",
    "acceptance:live-provider": "node --env-file-if-exists=.env.local scripts/acceptance/live-provider.mjs",
    "acceptance:stripe": "node --env-file-if-exists=.env.local scripts/acceptance/stripe.mjs",
    "acceptance:journey": "node --env-file-if-exists=.env.local scripts/acceptance/customer-journey.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.43.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "type": "module"
}
